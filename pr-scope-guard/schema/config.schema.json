{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bniladridas/cuda/pr-scope-guard/config.schema.json",
  "title": "PR Scope Guard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scopes"],
  "properties": {
    "version": {
      "const": 1
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scopes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  }
}
